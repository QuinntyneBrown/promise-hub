@startuml
!include <C4/C4_Container>
title C4 containers — Remind and total dollars
Person(guardian, "Guardian")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "learning-bond, api, components")
  Container(api, "API", ".NET 10 minimal APIs", "LearningBondGuardianEndpoints, LearningBondEndpoints (webhook), handlers, LearningBondReminderJob in the job runner")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "LearningBondReminders, LearningBondApplications, Messages, AuditEntries")
}
System_Ext(sms, "SMS and email providers", "Delivery")
System_Ext(program, "Benefit program", "Signed webhook")
Rel(guardian, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS with the link token")
Rel(api, db, "EF Core, tenant filter for the link's or the application's organization")
Rel(api, sms, "Message send job, SMS cap, STOP, email fallback")
Rel(program, api, "POST /learning-bond/webhooks/programs/{program}", "signed")
@enduml
