@startuml
!include <C4/C4_Container>
title C4 containers — List and apply for benefits
Person(guardian, "Guardian")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "learning-bond, api, components")
  Container(api, "API", ".NET 10 minimal APIs", "LearningBondGuardianEndpoints, BenefitsConsentFilter, handlers, BenefitRuleEvaluator")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "BenefitCatalogueEntries (platform), LearningBondApplications, LearningBondDocuments, AuditEntries")
  Container(files, "File store", "IFileStore", "Encrypted documents")
}
System_Ext(program, "Benefit program", "API or PDF form")
Rel(guardian, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS with the link token and the trusted device")
Rel(api, db, "EF Core, tenant filter for the link's organization; catalogue read without a tenant")
Rel(api, files, "Encrypted documents")
Rel(api, program, "IBenefitProgramChannel.SubmitAsync")
@enduml
