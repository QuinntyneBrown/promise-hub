@startuml
!include <C4/C4_Container>
title C4 containers — Open the guardian's Learning Bond page
Person(guardian, "Guardian")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "learning-bond, guardian, api, components")
  Container(api, "API", ".NET 10 minimal APIs", "LearningBondGuardianEndpoints, GuardianAccess, module gate, handlers")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "GuardianLinks, TrustedGuardianDevices, LearningBondSettings, LearningBondInvitations, LearningBondClaims, AuditEntries")
}
System_Ext(llm, "Language model", "ILanguageModel")
Rel(guardian, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS, link token and device token")
Rel(api, db, "EF Core, tenant filter for the link's organization")
Rel(api, llm, "LearningBondAgent.ExplainStep")
@enduml
