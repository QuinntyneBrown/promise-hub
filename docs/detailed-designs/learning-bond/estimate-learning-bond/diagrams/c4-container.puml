@startuml
!include <C4/C4_Container>
title C4 containers — Estimate the Learning Bond
Person(guardian, "Guardian")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "learning-bond, api, components")
  Container(api, "API", ".NET 10 minimal APIs", "LearningBondGuardianEndpoints, LearningBondEstimateHandler, LearningBondRule")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "LearningBondRules (platform), LearningBondClaims, LearningBondIntakes, Children, AuditEntries")
}
Rel(guardian, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS, link token and device token")
Rel(api, db, "EF Core; rules without a tenant filter, claims with the link's organization")
@enduml
