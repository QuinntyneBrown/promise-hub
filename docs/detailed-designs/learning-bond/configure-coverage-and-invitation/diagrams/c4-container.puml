@startuml
!include <C4/C4_Container>
title C4 containers — Configure coverage and the invitation
Person(admin, "Admin")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "learning-bond (coverage, invitation pages), api, components")
  Container(api, "API", ".NET 10 minimal APIs", "/learning-bond/settings, /learning-bond/invitation; RequireModule, ManageSettings")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "LearningBondSettings, Programs, Enrollments, Households, AuditEntries")
}
Rel(admin, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS")
Rel(api, db, "EF Core, tenant filter")
@enduml
