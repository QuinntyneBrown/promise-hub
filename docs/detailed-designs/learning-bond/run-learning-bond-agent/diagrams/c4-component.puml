@startuml
!include <C4/C4_Component>
title C4 components — Run the Learning Bond agent
Container_Boundary(web, "Angular app") {
  Component(bubble, "ph-agent-message", "components", "the step's fixed line, or the model's reply")
  Component(glue, "LearningBondAgentBubble", "learning-bond", "askAgent once per page; opens the Ask dialog")
  Component(dialog, "LearningBondAgentDialog", "learning-bond", "learning-bond-ask: ph-message-thread, ph-alert")
  Component(client, "LEARNING_BOND_API", "api", "askAgent(token, step, message?), agentConversation(token)")
}
Container_Boundary(api, "API") {
  Component(ep, "LearningBondGuardianEndpoints", "PromiseHub.Api", "POST /g/learning-bond/{token}/agent, GET .../agent/conversation")
  Component(agent, "LearningBondAgent", "Application/LearningBond", "AskAsync, ConversationAsync; SIN refusal, reply checks, read-only tools")
  Component(prompts, "LearningBondAgentPrompts", "Application/LearningBond", "fixed system prompt per step")
  Component(fallback, "AgentFallbackCopy", "Application/LearningBond", "approved line per step and language")
  Component(llm, "ILanguageModel", "Application/LearningBond", "ReplyAsync(request, runTool)")
  Component(claude, "ClaudeLanguageModel", "Infrastructure/LearningBond", "Anthropic SDK; UnconfiguredLanguageModel without a key")
}
System_Ext(vendor, "Claude", "Anthropic API")
Rel(glue, bubble, "reply")
Rel(glue, client, "askAgent")
Rel(dialog, client, "askAgent, agentConversation")
Rel(client, ep, "POST, GET")
Rel(ep, agent, "AskAsync, ConversationAsync")
Rel(agent, prompts, "For(step, language, organization, context)")
Rel(agent, llm, "ReplyAsync within the timeout")
Rel(agent, fallback, "slow, failing or unusable reply")
Rel(claude, llm, "implements")
Rel(claude, vendor, "messages with tools, effort low, up to 4 rounds")
@enduml
