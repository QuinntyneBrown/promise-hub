@startuml
title UML sequence — Model timeout fallback (L2-160, L2-163)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Guardian" as g
box "Frontend — Angular app" #E0F2FE
participant "ph-agent-bubble" as bubble
participant AgentFacade as facade
participant LEARNING_BOND_API as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant LearningBondGuardianEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant LearningBondAgent as agent
participant AgentFallbackCopy as fallback
end box
box "Backend — PromiseHub.Infrastructure" #FEF0C7
participant ILanguageModel as llm
end box
database "Database" as db
g -> bubble : opens learning-bond-consent
bubble -> bubble : renders AgentFallbackCopy.Line(Consent, language) at once; first words within 3 s p95 (L2-163 c5)
bubble -> facade : send(step Consent)
facade -> client : agent(token, request)
client -> api : POST /g/learning-bond/{token}/agent
api -> agent : ReplyAsync(scope, request)
agent -> llm : CompleteAsync(step prompt, redacted context, tools, 10 s)
alt no reply within 10 s, error or empty text
  llm --> agent : timeout
  agent -> fallback : Line(Consent, household language)
  fallback --> agent : approved wording of the step
  agent -> db : AgentMessage FromFallback, audit Agent fallback by step
  agent --> api : AgentReplyDto FromFallback=true (L2-160 c4)
else reply in time
  llm --> agent : text
  agent --> api : AgentReplyDto capped at 60 words
end
api --> facade : 200
facade -> bubble : keeps or replaces the line
g -> bubble : ticks the consent, types the name, continues to intake, review and submit without the model (L2-160 c4)
@enduml
