@startuml
title UML classes — Run the Learning Bond agent
class AgentContext <<record>> { Organization Children: AgentChild[] BenefitsChecked Unlocked AppliedFor }
class AgentChild <<record>> { FirstName Age? Claim? Paused? Estimate? }
class AgentFacts <<record>> { Context: AgentContext Amounts: int set }
class AskLearningBondAgentRequest <<record>> { Step Message? }
class LearningBondAgentReplyDto <<record>> { Step Fixed Reply? Source }
class LearningBondConversationDto <<record>> { Messages: LearningBondAgentMessageDto[] }
class LearningBondAgentMessageDto <<record>> { Role Text Step At }
class LearningBondAgentMessage { Id OrganizationId HouseholdId Step Role Text CreatedAt }
class LearningBondAgent { +AskAsync(request, ask): GuardianResult +ConversationAsync(request): GuardianResult }
class LearningBondAgentPrompts { +Steps +For(step, language, organization, context) }
class AgentFallbackCopy { +Welcome() +Consent() +Estimate() +SinRefused(code) +NumberRemoved(code) }
interface ILanguageModel { +ReplyAsync(LanguageModelRequest, runTool, ct): string? }
interface ILearningBondAgentSettings { +Timeout }
class LanguageModelRequest <<record>> { System History: LanguageModelTurn[] Message Tools: LanguageModelTool[] Language }
class LanguageModelToolCall <<record>> { Name Arguments }
class ClaudeLanguageModel
class UnconfiguredLanguageModel
class FakeLanguageModel
LearningBondAgent --> ILanguageModel
LearningBondAgent --> ILearningBondAgentSettings
LearningBondAgent --> LearningBondAgentPrompts
LearningBondAgent --> AgentFallbackCopy
LearningBondAgent ..> AgentFacts
AgentFacts *-- AgentContext
AgentContext "1" *-- "0..*" AgentChild
LearningBondAgent ..> AskLearningBondAgentRequest
LearningBondAgent ..> LearningBondAgentReplyDto
LearningBondAgent ..> LearningBondConversationDto
LearningBondConversationDto "1" *-- "0..*" LearningBondAgentMessageDto
LearningBondAgent ..> LearningBondAgentMessage
ILanguageModel ..> LanguageModelRequest
ILanguageModel ..> LanguageModelToolCall
ClaudeLanguageModel ..|> ILanguageModel
UnconfiguredLanguageModel ..|> ILanguageModel
FakeLanguageModel ..|> ILanguageModel
@enduml
