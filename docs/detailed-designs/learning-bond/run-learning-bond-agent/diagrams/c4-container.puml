@startuml
!include <C4/C4_Container>
title C4 containers — Run the Learning Bond agent
Person(guardian, "Guardian")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular", "learning-bond (LearningBondAgentBubble, LearningBondAgentDialog), api, components (ph-agent-message, ph-message-thread)")
  Container(api, "API", ".NET minimal APIs", "LearningBondGuardianEndpoints, LearningBondAgent, LearningBondAgentPrompts, AgentFallbackCopy")
  ContainerDb(db, "Database", "SQL (fake database in tests)", "LearningBondAgentMessages, LearningBondClaims, LearningBondApplications, AuditEntries")
}
System_Ext(llm, "Claude", "ClaudeLanguageModel through the Anthropic SDK when LearningBond:Agent:ApiKey is set; FakeLanguageModel in tests")
Rel(guardian, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS with the link token")
Rel(api, db, "EF Core, tenant filter for the link's organization")
Rel(api, llm, "ILanguageModel.ReplyAsync with read-only tools, LearningBond:Agent:TimeoutSeconds (10)")
@enduml
