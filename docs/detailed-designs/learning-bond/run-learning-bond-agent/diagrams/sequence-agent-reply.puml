@startuml
title UML sequence — A question with a tool call (L2-160, L2-161, L2-027)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Guardian" as g
box "Frontend — Angular app" #E0F2FE
participant LearningBondAgentDialog as dialog
participant LEARNING_BOND_API as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant LearningBondGuardianEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant LearningBondAgent as agent
end box
box "Backend — PromiseHub.Infrastructure" #FEF0C7
participant "ILanguageModel (ClaudeLanguageModel)" as llm
end box
database "Database" as db
g -> dialog : Ask a question: "How much will Sofía get?"
dialog -> client : askAgent(token, Estimate, message)
client -> api : POST /g/learning-bond/{token}/agent
api -> agent : AskAsync(request, ask)
agent -> agent : the link's household and organization; unknown link 410, module off 404
alt nine digits in the message
  agent -> db : "[number removed]" and the fixed refusal (L2-160 c9)
  agent --> api : reply = refusal, source fixed; the model is never called
else
  agent -> db : first names, ages, claim statuses, rule estimates and totals of this household (AgentFacts, c1)
  agent -> llm : ReplyAsync(step prompt, last 10 turns, message, five tools, runTool), timeout 10 s
  llm -> agent : runTool(GetEstimate, child "Sofía")
  alt child not in the link's household, or unknown tool
    agent --> llm : "Not found." or "No such tool."; audit not found or refused (c10)
  else own child
    agent --> llm : "Sofía: up to $1,700, by the Learning Bond rule version ..."; audit tool GetEstimate
  end
  llm --> agent : text in the household's language
  agent -> agent : at most 60 words, no nine digits, every amount from the rules, else null (c8)
  agent -> db : question and reply (or the fixed line) as LearningBondAgentMessage; audit replied on Estimate (model or fixed)
  agent --> api : LearningBondAgentReplyDto {step, fixed, reply, source}
end
api --> client : 200
client -> api : GET /g/learning-bond/{token}/agent/conversation
api --> dialog : LearningBondConversationDto, oldest first (c11)
dialog -> g : You and Learning Bond in ph-message-thread
@enduml
