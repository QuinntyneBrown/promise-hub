@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage terms and tracks
Person(user, "Program director", "Phone or laptop browser")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "programs library")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Endpoints, module gates, handlers")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "Tenant-filtered rows")
}
Rel(user, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
