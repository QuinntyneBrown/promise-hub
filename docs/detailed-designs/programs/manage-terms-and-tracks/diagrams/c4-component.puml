@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage terms and tracks
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(form, "ProgramFormPage", "Angular page", "program-form")
  Component(list, "ProgramsPage", "Angular page", "programs")
  Component(papi, "ProgramsApi", "Contract + HTTP client", "create, update, list")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "ProgramEndpoints", "Minimal API", "POST, PUT /programs")
  Component(rules, "ProgramRules", "Validation", "term up to 40 characters")
  Component(h, "Create/UpdateProgramHandler", "Handlers", "save, audit")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Programs, audit")
}
Rel(form, papi, "create, update")
Rel(list, papi, "list")
Rel(papi, ep, "JSON/HTTPS")
Rel(ep, h, "dispatches")
Rel(h, rules, "checks")
Rel(h, db, "writes")
@enduml
