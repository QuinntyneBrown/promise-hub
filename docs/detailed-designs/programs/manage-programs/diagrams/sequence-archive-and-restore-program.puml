@startuml
title UML sequence behaviour — Archive and restore a program
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program director" as actor
box "Frontend — PromiseHub web app, programs library" #E0F2FE
  participant "ProgramPage" as page
  participant "ArchiveProgramDialog" as dialog
  participant "ProgramsApi" as client
end box
box "Backend — PromiseHub API" #D1FADF
  participant "ProgramEndpoints" as endpoints
end box
box "Backend — PromiseHub Application and Domain (Programs)" #ECFDF3
  participant "ArchiveProgramCommandHandler" as archive
  participant "RestoreProgramCommandHandler" as restore
  participant "Program" as entity
end box
box "Backend — PromiseHub Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "PromiseHubDbContext" as db
end box
actor -> page : More actions > Archive at season end…
page -> dialog : Open
dialog --> actor : Warn that children are still enrolled; ask for the typed name
actor -> dialog : Type program name; Archive program
dialog -> client : archive(id, confirmName)
client -> endpoints : POST /programs/{id}/archive
endpoints -> endpoints : Authenticate; director or admin only (L2-007)
endpoints -> archive : Send ArchiveProgramCommand
archive -> db : Load Program by id within organization (L2-001)
db --> archive : Program
alt confirmName differs from Program.Name
  archive --> endpoints : Validation failure
  endpoints --> client : 400 ProblemDetails
  client --> dialog : Field error
  dialog --> actor : "Type the program name exactly"
else name matches
  archive -> entity : Archive(actor, now): Status = Archived, enrollment Closed (L2-012 AC3)
  entity --> archive : Transition applied
  archive -> db : End active enrollments as of today; SaveChanges
  db --> archive : Commit result
  archive -> audit : Record archive with before and after values (L2-032)
  audit --> archive : Recorded
  archive --> endpoints : Result
  endpoints --> client : 204 No Content
  client --> dialog : Done
  dialog --> actor : Program hidden from navigation and pickers; attendance stays in reports
end
...later...
actor -> page : Open archived program; Restore
page -> client : restore(id)
client -> endpoints : POST /programs/{id}/restore
endpoints -> restore : Send RestoreProgramCommand
restore -> db : Load Program
db --> restore : Program (Archived)
restore -> entity : Restore(actor, now): Status = Active
entity --> restore : Transition applied
restore -> db : SaveChanges
db --> restore : Commit result
restore -> audit : Record restore (L2-032)
audit --> restore : Recorded
restore --> endpoints : Result
endpoints --> client : 204 No Content
client --> page : Done
page --> actor : Program listed as Active again with its roster intact
@enduml
