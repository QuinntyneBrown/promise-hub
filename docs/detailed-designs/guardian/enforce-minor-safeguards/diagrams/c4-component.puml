@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Enforce minor safeguards
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "LearningPage", "Angular page", "Renders what the server answers")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(auth, "RequirePermission", "Endpoint filter", "Learn")
  Component(mod, "RequireModule", "Endpoint filter", "Learning")
  Component(f, "RequireGuardianConsent", "Endpoint filter", "Every request")
  Component(g, "ConsentGate", "Application service", "No caching")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Links, consents, policy, audit entries")
}
Rel(page, mod, "GET /learning/lessons")
Rel(mod, auth, "then")
Rel(auth, f, "then")
Rel(f, g, "GatedAsync")
Rel(g, db, "consent in force")
@enduml
