@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Withdraw guardian consent
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "GuardianConsentPage", "Angular page", "Given → withdrawn")
  Component(dlg, "WithdrawConsentDialog", "CDK dialog", "Confirm")
  Component(gapi, "GuardianApi", "Contract + HTTP client", "withdrawConsent")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "GuardianEndpoints", "Minimal API", "Anonymous")
  Component(h, "GuardianConsentHandler", "Application handler", "WithdrawAsync")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Links, consents, policy, audit entries")
}
Rel(page, dlg, "opens")
Rel(page, gapi, "withdrawConsent")
Rel(gapi, ep, "POST /g/consent/{token}/withdraw")
Rel(ep, h, "calls")
Rel(h, db, "withdrawal, audit entry")
@enduml
