@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read guardian announcements
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(home, "GuardianHomePage", "Angular page", "Announcements card, n new")
  Component(page, "GuardianAnnouncementsPage", "Angular page", "/g/home/:token/announcements")
  Component(gapi, "GuardianApi", "Contract + HTTP client", "announcements(), markAnnouncementsRead()")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "GuardianEndpoints", "Minimal API", "GET .../announcements, POST .../announcements/read")
  Component(h, "GuardianAnnouncementsHandler", "Handler", "household's sent Messages deliveries")
  Component(acc, "GuardianAccess", "Service", "link → household, organization, trusted device")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Messages, Deliveries (ReadAt)")
}
Rel(home, page, "links to")
Rel(page, gapi, "calls")
Rel(gapi, ep, "JSON/HTTPS")
Rel(ep, h, "calls")
Rel(h, acc, "ResolveAsync")
Rel(h, db, "reads and marks read")
@enduml
