@startuml
title UML sequence behaviour — Sign the consent
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Person" as actor
box "Frontend — PromiseHub web app" #E0F2FE
  participant "Page" as page
  participant "API client" as gapi
end box
box "Backend — PromiseHub.Api" #D1FADF
  participant "Endpoints" as ep
end box
box "Backend — PromiseHub.Application and Domain" #ECFDF3
  participant "Handler" as h
end box
box "Backend — PromiseHub.Infrastructure" #FFF4E5
  database "PromiseHub database" as db
  participant "IEmailSender" as mail
end box
actor -> page : open /g/consent/{token}
page -> gapi : consent(token)
gapi -> ep : GET /g/consent/{token}
ep -> h : GetAsync
h -> db : link by hash (consent link, ≤ 30 days), Roster on, trusted device (L2-026)
ep --> page : 200 Sofía, wording, status Needed, language es
page --> actor : guardian-consent (Spanish)
actor -> page : relationship, tick, "carmen rivera"
page -> gapi : giveConsent(token, answers)
gapi -> ep : POST /g/consent/{token}/sign
ep -> h : SignAsync
h -> db : guardian who may sign matches the typed name (L2-055)
h -> db : GuardianConsent (wording, hash, device, GC-ref), audit Signed
h -> mail : copy to the signer's email
ep --> page : 204
page --> actor : guardian-consent/signed
@enduml
