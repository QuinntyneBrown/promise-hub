@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Obtain required consent
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "LearningPage", "Angular page", "consent-required")
  Component(lapi, "LearningApi", "Contract + HTTP client", "askGuardian")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "ParticipantModuleEndpoints", "Minimal API", "Learning")
  Component(h, "ConsentRequestHandler", "Application handler", "Youth asks")
  Component(s, "ConsentRequestSender", "Application service", "Issue and deliver")
  Component(i, "GuardianLinkIssuer", "Application service", "IssueConsent")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Links, consents, policy, audit entries")
}
Rel(page, lapi, "askGuardian")
Rel(lapi, ep, "POST /learning/consent-request")
Rel(ep, h, "calls")
Rel(h, s, "send")
Rel(s, i, "issue")
Rel(s, db, "links, audit entry")
@enduml
