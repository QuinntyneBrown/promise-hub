@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Await program placement
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "LearningPage", "Angular page", "no-cohort")
  Component(lapi, "LearningApi", "Contract + HTTP client", "lessons")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "ParticipantModuleEndpoints", "Minimal API", "GET /learning/lessons")
  Component(cf, "GuardianConsentFilter", "Endpoint filter", "403 consent-required")
  Component(pf, "PlacementFilter", "Endpoint filter", "403 no-cohort")
  Component(p, "Placement", "Application service", "IsPlacedAsync")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Memberships, enrollments, programs")
}
Rel(page, lapi, "lessons")
Rel(lapi, ep, "GET /learning/lessons")
Rel(ep, cf, "first")
Rel(cf, pf, "then")
Rel(pf, p, "asks")
Rel(p, db, "reads")
@enduml
