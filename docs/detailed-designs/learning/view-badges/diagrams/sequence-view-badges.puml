@startuml
title UML sequence behaviour — Opening badges
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Youth (Sofía)" as actor
box "Frontend — PromiseHub web app" #E0F2FE
  participant "BadgesPage" as page
  participant "LearningApi" as lapi
end box
box "Backend — PromiseHub.Api" #D1FADF
  participant "LearningEndpoints" as ep
end box
box "Backend — PromiseHub.Application" #ECFDF3
  participant "BadgesViewHandler" as h
end box
box "Backend — PromiseHub.Infrastructure" #FFF4E5
  database "PromiseHub database" as db
end box
actor -> page : open from Learning
page -> lapi : badges()
lapi -> ep : GET /learning/badges
alt Learning off
  ep --> page : 404; the route redirects to Today
else no Learn permission, no consent or not placed
  ep --> page : 403; forbidden state (L2-087 c8)
else
  ep -> h : HandleAsync
  h -> db : her awards (deleted badges included), oldest first (L2-087 c4)
  h -> db : badges she can earn not held, with progress (module lessons done; 0 or 1 of 1)
  h -> db : her enrollments -> Joined milestones; next up (c5)
  h --> page : 200
  page --> actor : default, or empty with one action
end
@enduml
