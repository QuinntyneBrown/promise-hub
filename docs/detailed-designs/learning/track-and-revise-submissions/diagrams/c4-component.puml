@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Track and revise a submission
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(st, "SubmissionPage", "Angular page", "learn-submission")
  Component(form, "SubmitPage (revise)", "Angular page", "learn-submit/revise")
  Component(tl, "ph-timeline / ph-alert / ph-stat", "components library", "")
  Component(lapi, "LearningApi", "Contract + HTTP client", "LEARNING_API")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "LearningEndpoints", "Minimal API", "submissions/{id}, file, resubmit")
  Component(sh, "SubmissionViewHandler", "Handler", "status, copy, feedback, history; file to owner")
  Component(cmd, "SubmissionCommand", "Handler", "resubmit from NeedsRevision + audit")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "AssignmentSubmissions, SubmissionEvents")
  Component(fs, "IFileStore", "Port", "submission files")
}
Rel(st, tl, "composes")
Rel(st, lapi, "submission")
Rel(form, lapi, "resubmit")
Rel(lapi, ep, "HTTPS")
Rel(ep, sh, "GET")
Rel(ep, cmd, "POST")
Rel(sh, db, "reads own rows")
Rel(sh, fs, "opens file")
Rel(cmd, db, "writes + audit")
Rel(cmd, fs, "replaces file")
@enduml
