@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the learning journey
Person(user, "Youth", "Phone browser")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "learning library, api client, components")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Learning gate, Learn permission, consent and placement gates, handlers")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "Tenant-filtered rows")
}
Rel(user, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads", "EF Core")
@enduml
