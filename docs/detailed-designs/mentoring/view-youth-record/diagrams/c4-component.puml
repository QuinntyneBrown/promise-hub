@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a youth's record
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "MentorYouthDetailPage", "Angular page", "mentor-youth-detail")
  Component(mapi, "MentoringApi", "Contract + HTTP client", "youthRecord(childId)")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "MentoringEndpoints", "Minimal API", "Mentoring gate, MentorYouth permission")
  Component(h, "MentorYouthRecordHandler", "Handler", "mentor-safe fields only")
  Component(scope, "MentorScope", "Application service", "is this youth the caller's?")
  Component(audit, "IAuditWriter", "Audit", "Viewed, AccessDenied")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "Children, Guardians, Enrollments, YouthOnboardings, AttendanceRecords")
}
Rel(page, mapi, "youthRecord")
Rel(mapi, ep, "JSON/HTTPS")
Rel(ep, h, "dispatches")
Rel(h, scope, "checks assignment")
Rel(h, audit, "records the open or the refusal")
Rel(h, db, "reads")
@enduml
