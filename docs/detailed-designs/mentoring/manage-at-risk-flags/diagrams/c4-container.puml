@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage at-risk flags
Person(m, "Mentor", "Phone or laptop browser")
Person(d, "Program director or admin", "Laptop browser")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "mentoring library, api client, components, shell navigation")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Mentoring gate, MentorYouth or ReviewAtRiskFlags, MentorScope, handler, audit, notifications")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "Tenant-filtered AtRiskFlags, Notifications and AuditEntries")
}
Rel(m, web, "Uses", "HTTPS")
Rel(d, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
