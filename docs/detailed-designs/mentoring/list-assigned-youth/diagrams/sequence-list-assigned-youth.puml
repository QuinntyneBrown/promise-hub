@startuml
title UML sequence behaviour — Open Mentoring
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Daniel (Mentor)" as actor
box "Frontend — PromiseHub web app" #E0F2FE
  participant "MentoringPage (now MentorDashboardPage)" as page
end box
box "Backend — PromiseHub API" #D1FADF
  participant "MentoringEndpoints (MentorYouth, Mentoring)" as endpoint
end box
box "Backend — PromiseHub Application (Mentoring)" #ECFDF3
  participant "MentoringHandler" as handler
end box
actor -> page : Open /mentoring
page -> endpoint : GET /mentoring/youth
alt Mentoring off
  endpoint --> page : 404
else
  endpoint -> handler : Handle
  handler --> page : AssignedYouthDto (assigned only; none yet)
  page --> actor : "No youth assigned yet"
end
@enduml
