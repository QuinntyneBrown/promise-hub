@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Record mentor check-ins
Person(m, "Mentor", "Phone or laptop browser")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "mentoring library, api client, components")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Mentoring gate, MentorYouth permission, MentorScope, handlers, audit")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "Tenant-filtered MentorCheckIns and AuditEntries")
}
Rel(m, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
