@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Approve quiz assessments
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(qp, "QuizApprovalsPage", "Angular page", "mentor-quiz-approvals")
  Component(dl, "ApproveQuizDialog / ApproveAllQuizzesDialog", "CDK Dialog", "")
  Component(mapi, "MentoringApi", "Contract + HTTP client", "MENTORING_API")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "MentoringEndpoints", "Minimal API", "quiz-approvals, approve, approve-all")
  Component(h, "QuizApprovalHandler", "Handler", "list, approve, approve all")
  Component(sc, "MentorYouthMemberships", "Service", "scope")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "QuizAttempts, Notifications, AuditEntries")
}
Rel(qp, dl, "opens")
Rel(qp, mapi, "quizApprovals")
Rel(dl, mapi, "approveQuiz, approveAllQuizzes")
Rel(mapi, ep, "HTTPS")
Rel(ep, h, "GET/POST")
Rel(h, sc, "scope")
Rel(h, db, "reads and writes")
@enduml
