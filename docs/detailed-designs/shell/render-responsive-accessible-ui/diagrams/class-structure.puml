@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Render responsive, accessible UI

enum Theme {
  Light
  Dark
  System
}

enum BreakpointRange {
  Under640
  From640
  From768
  From1024
  From1280
}

class ThemeService {
  -string storageKey
  +Signal<Theme> theme$
  +apply(theme: Theme): void
  +toggle(): void
  -readStored(): Theme
  -osPreference(): Theme
}

class BreakpointService {
  +Signal<BreakpointRange> current$
  +atLeast(range: BreakpointRange): boolean
}

class ContainerComponent {
  +maxWidth: "1280px"
}
class GridComponent {
  +statsPerRow(): number
  +columns(): number
}
class StackComponent {
  +gap: "var(--layout-gutter)"
}

class DialogComponent {
  -FocusTrap trap
  -HTMLElement opener
  +open(): void
  +close(): void
  -setInert(root: HTMLElement, inert: boolean): void
  -restoreFocus(): void
}

class DrawerComponent
DialogComponent <|-- DrawerComponent

class ToastService {
  +show(message: string, options?: ToastOptions): ToastRef
  +error(message: string): ToastRef
}
class ToastComponent {
  +role: "status" | "alert"
  +ariaLive: "polite"
}

class ErrorSummaryComponent {
  +errors: FieldError[]
  +focus(): void
}

class ShellComponent {
  +onRouteChange(): void
}
class AccountMenuComponent {
  +toggleTheme(): void
}

class AxeFixture {
  +checkPage(page: Page, theme: Theme): Promise<void>
  +assertNoHorizontalScroll(page: Page): Promise<void>
}

ThemeService --> Theme
BreakpointService --> BreakpointRange
GridComponent ..> BreakpointService
DialogComponent ..> BreakpointService : bottom sheet under 640 px
ToastService --> "*" ToastComponent : creates
ShellComponent ..> ThemeService
ShellComponent *-- ToastComponent : live region
AccountMenuComponent ..> ThemeService
AxeFixture ..> ThemeService : sets data-theme
@enduml
