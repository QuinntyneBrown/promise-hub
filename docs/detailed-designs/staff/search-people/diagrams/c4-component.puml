@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Search people
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "PeoplePage", "administration library", "filters, table, pagination")
  Component(pag, "PhPagination", "components library", "Previous, pages, Next")
  Component(papi, "PeopleApi", "api client", "list(query)")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "PeopleEndpoints", "Minimal API", "ManageStaff")
  Component(h, "PeopleHandler", "Application", "filters, pages, module fields")
  Component(gate, "IModuleGate", "Application", "Mentoring on?")
  ComponentDb(db, "PromiseHub database", "EF Core", "Memberships, Enrollments, SignInAttempts")
}
Rel(page, pag, "renders")
Rel(page, papi, "list")
Rel(papi, ep, "GET /people")
Rel(ep, h, "calls")
Rel(h, gate, "asks")
Rel(h, db, "queries")
@enduml
