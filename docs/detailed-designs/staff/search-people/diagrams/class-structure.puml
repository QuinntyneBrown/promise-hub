@startuml
title Class structure — Search people
class Membership {
  Id : Guid
  OrganizationId : Guid
  PersonName : string
  Email : string
  Role : Role
  RemovedAt : DateTimeOffset?
  DeactivatedAt : DateTimeOffset?
  ChildId : Guid?
}
class PeopleHandler {
  ListAsync(PeopleQuery) : PeopleListResult
}
class PeopleQuery {
  Q : string?
  Role : string?
  Status : string?
  ProgramId : Guid?
  Page : int
}
class PeoplePageDto {
  Items : PersonRowDto[]
  Total : int
  Page : int
  PageSize : int
  Roles : string[]
  Programs : ProgramOptionDto[]
}
class PersonRowDto {
  Id : Guid
  Name : string
  Email : string
  Role : string
  Status : string
  Programs : string[]
  LastSignedInAt : DateTimeOffset?
  IsYou : bool
  Mentoring : PersonMentoringDto?
}
PeopleHandler ..> PeopleQuery
PeopleHandler ..> PeoplePageDto : answers
PeoplePageDto *-- PersonRowDto
PeopleHandler --> Membership : reads
@enduml
