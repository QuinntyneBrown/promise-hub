@startuml
title UML sequence — Register volunteer interest (L2-134, L2-031)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Leo (visitor)" as v
box "Frontend — Angular app" #E0F2FE
participant VolunteerDialog as page
participant WEBSITE_API as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant WebsiteEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant PublicSiteResolver as r
participant WebsiteRequestsHandler as h
end box
database "Database" as db
v -> page : opens the page
page -> client : volunteer(slug, offer)
client -> api : POST /website/harbourview/volunteer
api -> r : ResolveAsync(address)
r -> db : organization by WebsiteSlug, not suspended (L2-132 c4)
r -> db : ModuleConfiguration of that organization
alt unknown, suspended or Public website off
  r --> api : null
  api --> page : 404, nothing stored (L2-132 c4)
else published
  r -> r : tenant resolved for a visitor (actor "Website visitor")
  api -> h : VolunteerAsync
  h -> h : acknowledgement required, else 422 (L2-134 c2)
  h -> db : limit (L2-134 c4)
  h -> db : VolunteerInterest, audit Created
  api --> page : 204
  page -> v : dialog closes, toast
end
@enduml
