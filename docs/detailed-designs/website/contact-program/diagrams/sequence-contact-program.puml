@startuml
title UML sequence — Contact the program (L2-134, L2-031)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Visitor" as v
box "Frontend — Angular app" #E0F2FE
participant SiteContactPage as page
participant WEBSITE_API as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant WebsiteEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant PublicSiteResolver as r
participant WebsiteRequestsHandler as h
end box
database "Database" as db
v -> page : opens the page
page -> client : contact(slug, message)
client -> api : POST /website/harbourview/contact
api -> r : ResolveAsync(address)
r -> db : organization by WebsiteSlug, not suspended (L2-132 c4)
r -> db : ModuleConfiguration of that organization
alt unknown, suspended or Public website off
  r --> api : null
  api --> page : 404, nothing stored (L2-132 c4)
else published
  r -> r : tenant resolved for a visitor (actor "Website visitor")
  api -> h : ContactAsync
  h -> h : trim, required, lengths, email, topic; else 422 (L2-134 c1, c5)
  h -> db : five from this email in the last hour? then 429 (L2-134 c4)
  h -> db : ContactMessage for this organization, audit Created (L2-134 c1, c6)
  api --> page : 204
  page -> v : Message sent
end
@enduml
