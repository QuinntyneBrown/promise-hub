@startuml
title UML sequence — Start a donation (L2-134, L2-031)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Visitor" as v
box "Frontend — Angular app" #E0F2FE
participant DonationDialog as page
participant WEBSITE_API as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant WebsiteEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant PublicSiteResolver as r
participant WebsiteRequestsHandler as h
end box
database "Database" as db
v -> page : opens the page
page -> client : donate(slug, $50)
client -> api : POST /website/harbourview/donations
api -> r : ResolveAsync(address)
r -> db : organization by WebsiteSlug, not suspended (L2-132 c4)
r -> db : ModuleConfiguration of that organization
alt unknown, suspended or Public website off
  r --> api : null
  api --> page : 404, nothing stored (L2-132 c4)
else published
  r -> r : tenant resolved for a visitor (actor "Website visitor")
  api -> h : DonateAsync
  h -> h : amount 20, 50 or 100; name; email; else 422 (L2-134 c3)
  h -> db : limit (L2-134 c4)
  h -> h : IPaymentProvider.StartCheckoutAsync
  alt no provider
    api --> page : 503 unavailable, nothing stored
  else checkout
    h -> db : DonationPledge with the reference only, audit Created
    api --> page : checkout URL
    page -> v : Open secure payment (new tab)
  end
end
@enduml
