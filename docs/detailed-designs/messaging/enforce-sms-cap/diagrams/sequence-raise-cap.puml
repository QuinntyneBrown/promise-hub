@startuml
title UML sequence behaviour — Raise the cap and resume paused texts
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin" as actor
box "Frontend — PromiseHub web app, settings library" #E0F2FE
  participant "NotificationSettingsPage" as page
  participant "SettingsApi" as client
end box
box "Backend — PromiseHub API" #D1FADF
  participant "SettingsEndpoints" as endpoints
end box
box "Backend — PromiseHub Application and Domain" #ECFDF3
  participant "UpdateSmsCapCommandHandler" as handler
  participant "SmsUsagePeriod" as period
end box
box "Backend — PromiseHub Infrastructure" #FFF4E5
  participant "IAuditWriter" as audit
  participant "ResumePausedTextsJob" as resume
  participant "SendMessageJob" as send
  database "PromiseHub database" as db
end box

actor -> page : Enter new monthly cap, Save
page -> client : updateSmsCap(segments)
client -> endpoints : PUT /settings/notifications/sms-cap
endpoints -> endpoints : Authenticate, resolve organization, require Settings.Manage
endpoints -> handler : Send UpdateSmsCapCommand
handler -> db : Load current SmsUsagePeriod and plan limits
db --> handler : Period, PlanLimits
alt cap below segments already used this month
  handler --> endpoints : Validation failure "below used"
  endpoints --> client : 422 ProblemDetails
  client --> page : Inline error on the cap field
else cap above plan allowance
  handler --> endpoints : Validation failure "above plan"
  endpoints --> client : 422 ProblemDetails
  client --> page : Inline error with link to change-plan
else valid
  handler -> period : SetCap(cap)
  handler -> audit : Cap changed, before and after (L2-032)
  handler -> db : Save in one unit of work
  db --> handler : Committed
  opt new cap greater than old cap (L2-022 criterion 3)
    handler -> resume : Enqueue ResumePausedTextsJob(organizationId)
  end
  handler --> endpoints : Result ok
  endpoints --> client : 200
  client --> page : Saved
  page --> actor : "Saved just now", banner clears on next refresh
end

resume -> db : Deliveries with status Paused for the organization
db --> resume : Paused deliveries
loop each paused delivery
  resume -> send : Re-queue delivery through the normal reserve-and-send path
end
resume -> db : Record run; completes within 5 minutes of the raise
@enduml
