@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deliver real-time events
Person(user, "Signed-in member", "Staff, mentor or youth")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "messaging feature library, api client")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Endpoints, handlers, module and permission gates")
  ContainerDb(db, "PromiseHub database", "EF Core", "Tenant-owned rows filtered by organization")
}
Rel(user, web, "uses", "HTTPS")
Rel(web, api, "JSON over HTTPS, cookie session")
Rel(api, db, "reads and writes")
Rel(api, web, "text/event-stream on GET /realtime")
@enduml
