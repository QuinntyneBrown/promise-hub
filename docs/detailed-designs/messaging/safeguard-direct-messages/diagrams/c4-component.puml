@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Safeguard direct messages
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "ConversationPage", "Angular page", "blocked alert, read-only view")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "ConversationEndpoints", "Minimal API", "Messages and Mentoring on; mentor, youth or supervisor")
  Component(acc, "ConversationAccess", "Service", "tenant, assignment, supervisor, consent")
  Component(gate, "ConsentGate", "Service", "consent in force for a minor (ADR 0046)")
  Component(audit, "IAuditWriter", "Port", "Viewed Conversation, Created DirectMessage")
  ComponentDb(db, "PromiseHub database", "EF Core", "tenant-owned rows")
}
Rel(page, ep, "JSON/HTTPS")
Rel(ep, acc, "every call")
Rel(acc, gate, "GatedAsync(youth)")
Rel(acc, db, "memberships, YouthMentor")
Rel(ep, audit, "supervisor views, sends")
@enduml
