@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Set privacy and residency

Container(web, "PromiseHub web app", "Angular", "SettingsPrivacyPage, PrivacyApi; GuardianDataRequestDialog, GuardianDataRequestsApi")
Container_Boundary(api, "PromiseHub API") {
  Component(privacyEndpoints, "PrivacyEndpoints", "Minimal API group", "/privacy; admin roles")
  Component(guardianEndpoints, "GuardianDataRequestEndpoints", "Minimal API group", "/g/{token}/data-requests on the verified guardian link")
  Component(platformEndpoints, "PlatformPrivacyEndpoints", "Minimal API group", "/admin/organizations/{id}/region; PlatformAdmin")
  Component(getHandler, "GetPrivacySettingsQueryHandler", "Application query handler", "Region, security facts, retention")
  Component(retentionHandler, "SaveRetentionPolicyCommandHandler", "Application handler", "Persists retention choices")
  Component(regionHandler, "ChangeDataRegionCommandHandler", "Application handler", "Platform admin only")
  Component(submitHandler, "SubmitDataRequestCommandHandler", "Application handler", "Creates DataRequest; notifies admins")
  Component(exportHandler, "FulfilExportCommandHandler", "Application handler", "Household-only export via verified link")
  Component(deleteHandler, "FulfilDeletionCommandHandler", "Application handler", "Soft-delete; purge after 30 days")
  Component(retentionJob, "ApplyRetentionJob", "Per-tenant job", "Removes signature detail; anonymizes; purges")
  Component(policy, "RetentionPolicy", "Domain entity", "Consent and inactive-family retention")
  Component(request, "DataRequest", "Domain entity", "Export or Deletion for a household")
  ComponentDb(db, "PromiseHubDbContext", "EF Core", "Region-selected connection")
  Component(exportWriter, "ExportWriter / IFileStorage", "Infrastructure", "PDF and spreadsheet export")
  Component(link, "VerifiedLinkService", "Infrastructure", "Verified download link")
  Component(jobs, "JobRunner", "Infrastructure", "Schedules ApplyRetentionJob per tenant")
  Component(emailSender, "IEmailSender", "Infrastructure", "Export link and notifications")
  Component(audit, "AuditLog", "Infrastructure", "Every privacy action")
}

Rel(web, privacyEndpoints, "Calls", "JSON/HTTPS")
Rel(web, guardianEndpoints, "Calls", "JSON/HTTPS")
Rel(privacyEndpoints, getHandler, "Sends GetPrivacySettingsQuery")
Rel(privacyEndpoints, retentionHandler, "Sends SaveRetentionPolicyCommand")
Rel(privacyEndpoints, exportHandler, "Sends FulfilExportCommand")
Rel(privacyEndpoints, deleteHandler, "Sends FulfilDeletionCommand")
Rel(guardianEndpoints, submitHandler, "Sends SubmitDataRequestCommand")
Rel(platformEndpoints, regionHandler, "Sends ChangeDataRegionCommand")
Rel(retentionHandler, policy, "Updates")
Rel(submitHandler, request, "Creates")
Rel(exportHandler, request, "Marks fulfilled")
Rel(exportHandler, exportWriter, "Writes export")
Rel(exportHandler, link, "Issues link")
Rel(exportHandler, emailSender, "Emails link")
Rel(deleteHandler, db, "Soft-deletes household", "EF Core")
Rel(jobs, retentionJob, "Runs per tenant")
Rel(retentionJob, policy, "Reads")
Rel(retentionJob, db, "Deletes signature detail; purges", "EF Core")
Rel(retentionHandler, db, "Saves", "EF Core")
Rel(exportHandler, audit, "Writes entry")
Rel(retentionJob, audit, "Writes entry")
@enduml
