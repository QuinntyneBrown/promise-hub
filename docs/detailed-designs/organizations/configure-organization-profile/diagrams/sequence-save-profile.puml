@startuml
title UML sequence — Save the organization profile (L2-122)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
actor "Tom (Admin)" as p
box "Frontend — Angular app (settings, api)" #E0F2FE
participant OrganizationProfileDialog as dlg
participant HttpOrganizationSettingsApi as client
end box
box "Backend — PromiseHub.Api" #D1FADF
participant SettingsEndpoints as api
end box
box "Backend — PromiseHub.Application" #ECFDF3
participant OrganizationProfileHandler as handler
end box
p -> dlg : Edit profile, new phone, Save profile
dlg -> client : saveProfile(profile)
client -> api : PUT /settings/organization/profile
api -> api : ManageSettings or 403 (c4)
api -> handler : SaveAsync
handler -> handler : name, city, email, phone, time zone by field (c3)
handler -> handler : active organization only, audit changed fields (c2, c5)
api --> client : 204 or 422 { errors }
dlg -> p : closes; toast Organization profile saved, or inline errors with a summary
@enduml
