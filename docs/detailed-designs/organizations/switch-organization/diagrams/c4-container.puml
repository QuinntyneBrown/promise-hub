@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Switch organization

Person(person, "Multi-organization staff member", "Switches between organizations")
System_Boundary(promisehub, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular", "Top bar switcher from the organizations library; reload on switch")
  Container(api, "PromiseHub API", "ASP.NET Core minimal API", "Membership endpoints; tenant context middleware")
  ContainerDb(db, "PromiseHub database", "SQL via EF Core", "Persons, memberships, organizations, audit log")
  ContainerDb(session, "Session store", "Infrastructure", "Active membership per session")
}

Rel(person, web, "Uses", "HTTPS")
Rel(web, api, "GET /me/memberships, POST /me/memberships/{id}/activate", "JSON/HTTPS")
Rel(api, db, "Reads memberships; writes audit", "EF Core")
Rel(api, session, "Reads and rewrites ActiveMembershipId")
@enduml
