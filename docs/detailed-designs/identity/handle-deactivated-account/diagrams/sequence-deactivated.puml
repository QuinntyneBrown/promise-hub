@startuml
title UML sequence behaviour — Sign in after removal, and removal mid-session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Nadia (Youth)" as actor
box "Frontend — PromiseHub web app" #E0F2FE
  participant "SignInPage" as page
  participant "authGuard" as guard
end box
box "Backend — PromiseHub.Api" #D1FADF
  participant "AuthEndpoints" as ep
  participant "TenantContextMiddleware" as mw
end box
box "Backend — PromiseHub.Application and Domain" #ECFDF3
  participant "SignInHandler" as h
end box
box "Backend — PromiseHub.Infrastructure" #FFF4E5
  database "PromiseHub database" as db
end box
actor -> page : right password
page -> ep : POST /auth/sign-in
ep -> h : SignInCommand
h -> db : password ok, no current membership
ep --> page : 403 account-deactivated (L2-050)
page --> actor : This account is inactive
== signed in when an admin removes the last membership ==
actor -> guard : next page
guard -> mw : GET /me
mw -> db : membership removed, no other
mw --> guard : 401 account-deactivated
guard --> actor : /account-deactivated
@enduml
