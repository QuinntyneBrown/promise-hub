@startuml
!include <C4/C4_Container>
title C4 containers — View the cohort report
Person(staff, "Program director, admin or site lead")
System_Boundary(ph, "PromiseHub") {
  Container(web, "Angular app", "Angular 22", "reports, api, components")
  Container(api, "API", ".NET 10 minimal APIs", "Module gates, ViewReports, handlers")
  ContainerDb(db, "Database", "SQL (SQLite in tests)", "Programs, Enrollments, Children, Events, AttendanceRecords, LessonProgress, AtRiskFlags, MentorCheckIns")
}
Rel(staff, web, "Uses", "HTTPS")
Rel(web, api, "JSON over HTTPS with the session cookie")
Rel(api, db, "EF Core, tenant filter")
@enduml
