@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Alert no-show and end session

Person(lead, "Site lead", "Ends the session; sees alerts on the roster")
Person(director, "Program director", "Reviews attendance history")
Person_Ext(guardian, "Guardian", "Receives the no-show text and replies 1 or 2")
System(ph, "PromiseHub", "Roll Call: no-show job, end session, attendance history")
System_Ext(sms, "SMS provider", "Delivers texts and posts inbound replies")
System_Ext(email, "Email provider", "Fallback channel at the SMS cap")

Rel(lead, ph, "Ends session using", "HTTPS")
Rel(director, ph, "Views attendance history in", "HTTPS")
Rel(ph, sms, "Sends no-show alert via", "HTTPS API")
Rel(sms, guardian, "Delivers text to")
Rel(guardian, sms, "Replies 1 or 2")
Rel(sms, ph, "Posts inbound reply to webhook", "HTTPS")
Rel(ph, email, "Sends alert by email at SMS cap", "SMTP/API")
@enduml
