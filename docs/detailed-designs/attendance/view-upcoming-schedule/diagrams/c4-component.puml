@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View upcoming schedule
Container_Boundary(web, "PromiseHub web app (Angular)") {
  Component(page, "MySchedulePage", "Angular page", "/my-schedule, day groups")
  Component(aapi, "AttendanceApi", "Contract + HTTP client", "ATTENDANCE_API.mine()")
}
Container_Boundary(api, "PromiseHub API (ASP.NET Core)") {
  Component(ep, "AttendanceEndpoints", "Minimal API", "GET /sessions/mine")
  Component(h, "MyScheduleHandler", "Handler", "assignments in the next 28 days")
  Component(r, "SessionReader", "Service", "roster size")
  ComponentDb(db, "PromiseHub database", "SQLite via EF Core", "SessionStaff, Events, Programs, Enrollments, WalkIns")
}
Rel(page, aapi, "mine()")
Rel(aapi, ep, "JSON/HTTPS")
Rel(ep, h, "calls")
Rel(h, r, "RosterChildIdsAsync")
Rel(h, db, "reads")
Rel(r, db, "reads")
@enduml
