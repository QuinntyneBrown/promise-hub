@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View today's session
Person(v, "Volunteer", "Leo Martins")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "today library, shell navigation, api client, components")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Roll Call gate, RunSessions, SessionAccess, tenant filter")
