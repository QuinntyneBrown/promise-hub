@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show offline sync state
Person(m, "Mentor", "Runs his cohorts' sessions")
Person(s, "Site lead", "Runs any session")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "attendance library, api client with OfflineStore")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "session roster endpoint")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "AttendanceRecords, Events")
}
Rel(m, web, "Uses", "HTTPS")
Rel(s, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
