@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sync offline attendance
Person(m, "Mentor", "Runs his cohorts' sessions")
Person(s, "Site lead", "Runs any session")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "attendance library, api client with OfflineStore")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Roll Call gate, attendance handlers, idempotency by client action id")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "AttendanceRecords, AttendanceEvents, AuditEntries")
}
Rel(m, web, "Uses", "HTTPS")
Rel(s, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
