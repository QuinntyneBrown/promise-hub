@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Review attendance
Person(d, "Program director", "Laptop or phone")
Person(m, "Mentor", "Phone")
System_Boundary(ph, "PromiseHub") {
  Container(web, "PromiseHub web app", "Angular 22", "attendance library, api client, components")
  Container(api, "PromiseHub API", "ASP.NET Core, .NET 10", "Roll Call gate, ReviewAttendance, CorrectAttendance, attendance handlers, audit")
  ContainerDb(db, "PromiseHub database", "SQLite via EF Core", "Tenant-filtered Programs, Events, Enrollments, AttendanceRecords, AttendanceEvents, CohortMentors, AuditEntries")
}
Rel(d, web, "Uses", "HTTPS")
Rel(m, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
