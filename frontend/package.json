{
  "name": "promisehub-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold only. Overwrite or delete as implementation requires. No product logic is implemented.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve promisehub",
    "build": "ng build promisehub",
    "build:all": "node ../eng/build-frontend.mjs",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build:all",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.56.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "ng-packagr": "22.2.5",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  }
}
