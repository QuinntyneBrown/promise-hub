    "promisehub": {
      "projectType": "application",
      "root": "projects/promisehub",
      "sourceRoot": "projects/promisehub/src",
      "prefix": "ph",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/promisehub",
            "index": "projects/promisehub/src/index.html",
            "browser": "projects/promisehub/src/main.ts",
            "tsConfig": "projects/promisehub/tsconfig.app.json",
            "assets": ["projects/promisehub/src/favicon.ico"],
            "styles": [
              "projects/components/src/styles/tokens.css",
              "projects/components/src/styles/foundation.css",
              "projects/promisehub/src/styles.css"
            ],
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "promisehub:build:production"
            },
            "development": {
              "buildTarget": "promisehub:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/promisehub/proxy.conf.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/promisehub/**/*.ts", "projects/promisehub/**/*.html"]
          }
        }
      }
